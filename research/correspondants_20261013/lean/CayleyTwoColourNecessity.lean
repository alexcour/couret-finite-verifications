/-!
COU-20 — research branch only, spectral necessity work in progress.

This file is deliberately separate from the certified Core/Family/Abelian/
Spectral/Parity modules. It does not claim a new Lean or GitHub Actions
certificate until it has been compiled against the pinned toolchain.

The cyclic lemma below produces an odd *discriminating* exponent. It is
slightly more general than the canonical candidate |Q|/3: its exponent
need not be the least such one. Directed adjacency and loops are untouched.

The generic rational charpoly-to-all-power-traces theorem is NOT assumed as
proved. The final assembly is explicitly conditional on that missing bridge.
-/

set_option autoImplicit false
noncomputable section

open Matrix

namespace Couret.CayleyNecessity

/-- Odd cardinality lets us change any natural multiple to an odd one,
without changing its value: adding the group cardinal annihilates alpha. -/
theorem oddify_nsmul
    {Q : Type*} [AddGroup Q] [Finite Q] (alpha beta : Q)
    (hcard : Odd (Nat.card Q)) (k : ℕ) (hk : k • alpha = beta) :
    ∃ n : ℕ, Odd n ∧ n • alpha = beta := by
  classical
  rcases Nat.even_or_odd k with heven | hodd
  · refine ⟨k + Nat.card Q, ?_, ?_⟩
    · obtain ⟨u, hu⟩ := heven
      obtain ⟨v, hv⟩ := hcard
      refine ⟨u + v, ?_⟩
      omega
    · rw [add_nsmul, card_nsmul_eq_zero', add_zero]
      exact hk
  · exact ⟨k, hodd, hk⟩

/-- In a finite odd-order cyclic additive group, every element or its
negative is reached by an odd natural multiple of a specified generator.
The sign is harmless for the two return tests in the directed triple pair. -/
theorem odd_multiple_or_neg_of_cyclic
    {Q : Type*} [AddCommGroup Q] [Finite Q] (alpha delta : Q)
    (hgen : AddSubgroup.zmultiples alpha = ⊤)
    (hcard : Odd (Nat.card Q)) :
    ∃ n : ℕ, Odd n ∧ (n • alpha = delta ∨ n • alpha = -delta) := by
  classical
  have hmem : delta ∈ AddSubgroup.zmultiples alpha := by
    rw [hgen]
    exact AddSubgroup.mem_top delta
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
  rcases le_total 0 k with hpos | hneg
  · let n : ℕ := k.toNat
    have hcast : (n : ℤ) = k := Int.toNat_of_nonneg hpos
    have hnat : n • alpha = delta := by
      have h : (n : ℤ) • alpha = delta := by rw [hcast]; exact hk
      simpa only [natCast_zsmul] using h
    obtain ⟨m, hm, heq⟩ := oddify_nsmul alpha delta hcard n hnat
    exact ⟨m, hm, Or.inl heq⟩
  · let n : ℕ := (-k).toNat
    have hcast : (n : ℤ) = -k := Int.toNat_of_nonneg (neg_nonneg.mpr hneg)
    have hnat : n • alpha = -delta := by
      have h : (n : ℤ) • alpha = -delta := by
        rw [hcast, neg_zsmul, hk]
      simpa only [natCast_zsmul] using h
    obtain ⟨m, hm, heq⟩ := oddify_nsmul alpha (-delta) hcard n hnat
    exact ⟨m, hm, Or.inr heq⟩

end Couret.CayleyNecessity

namespace Couret.CayleyDoublet

open Couret.CayleyNecessity

variable {G : Type*} [AddCommGroup G] [DecidableEq G] [Fintype G]

/-- An odd quotient generated by a+h produces an odd return to +d or -d,
without imposing a parity character or presuming any graph isomorphism. -/
theorem abelianThree_odd_quotient_return (a d h : G)
    (hcyc : AddSubgroup.closure ({a, h} : Set G) = ⊤)
    (hodd : Odd (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    ∃ n : ℕ, Odd n ∧
      (n • a + d ∈ AddSubgroup.zmultiples h ∨
       n • a - d ∈ AddSubgroup.zmultiples h) := by
  classical
  let H : AddSubgroup G := AddSubgroup.zmultiples h
  have hgen : AddSubgroup.zmultiples (a : G ⧸ H) = ⊤ :=
    abelian_quotient_zmultiples_generator_of_pair a h hcyc
  obtain ⟨n, hn, hplus | hminus⟩ :=
    odd_multiple_or_neg_of_cyclic (a : G ⧸ H) (d : G ⧸ H) hgen hodd
  · refine ⟨n, hn, Or.inr ?_⟩
    apply (QuotientAddGroup.eq_zero_iff (n • a - d)).mp
    change n • (a : G ⧸ H) - (d : G ⧸ H) = 0
    rw [hplus]
    exact sub_self _
  · refine ⟨n, hn, Or.inl ?_⟩
    apply (QuotientAddGroup.eq_zero_iff (n • a + d)).mp
    change n • (a : G ⧸ H) + (d : G ⧸ H) = 0
    rw [hminus]
    exact neg_add_cancel _

/-- The certified odd-trace criterion converts the cyclic return into an
actual difference of odd-power traces of the directed rational adjacency
matrices. All half-turn and quotient-order hypotheses are retained. -/
theorem abelianThree_odd_trace_witness_of_odd_quotient (a d h : G)
    (hhalf : h + h = 0) (hne : h ≠ 0)
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hcyc : AddSubgroup.closure ({a, h} : Set G) = ⊤)
    (hodd : Odd (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    ∃ n : ℕ,
      Matrix.trace (abelianCayleyMatrix (AbelianSource a d h) ^ (2 * n + 1)) ≠
        Matrix.trace (abelianCayleyMatrix (AbelianTarget a d h) ^ (2 * n + 1)) := by
  obtain ⟨k, hk, hreturn⟩ := abelianThree_odd_quotient_return a d h hcyc hodd
  obtain ⟨n, hn⟩ := hk
  refine ⟨n, (abelianThree_odd_trace_ne_iff a d h hhalf hne horder n).mpr ?_⟩
  simpa only [hn] using hreturn

/-- First-degree instance of the rational charpoly/trace bridge.
The all-powers version still requires Newton identities (or an equivalent
formal spectral argument); this lemma must not be used as a substitute. -/
theorem rational_trace_eq_of_charpoly_eq
    {i : Type*} [Fintype i] [DecidableEq i]
    (A B : Matrix i i ℚ) (h : A.charpoly = B.charpoly) :
    Matrix.trace A = Matrix.trace B := by
  classical
  cases isEmpty_or_nonempty i with
  | inl _ =>
      simp [Matrix.trace]
  | inr _ =>
      rw [Matrix.trace_eq_neg_charpoly_coeff,
        Matrix.trace_eq_neg_charpoly_coeff, h]

/-- An exact assembly interface for the missing all-power-traces lemma.
This statement is CONDITIONAL: hbridge is NOT derived here from charpoly
equality and therefore this is not the desired unconditional necessity. -/
theorem abelianThree_spectral_necessity_of_trace_bridge (a d h : G)
    (hhalf : h + h = 0) (hne : h ≠ 0)
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (hbridge :
      ∀ n : ℕ,
        (abelianCayleyMatrix (AbelianSource a d h)).charpoly =
          (abelianCayleyMatrix (AbelianTarget a d h)).charpoly →
        Matrix.trace (abelianCayleyMatrix (AbelianSource a d h) ^ n) =
          Matrix.trace (abelianCayleyMatrix (AbelianTarget a d h) ^ n))
    (hcospec :
      (abelianCayleyMatrix (AbelianSource a d h)).charpoly =
        (abelianCayleyMatrix (AbelianTarget a d h)).charpoly) :
    AddSubgroup.closure ({a, h} : Set G) ≠ ⊤ ∨
      Even (Nat.card (G ⧸ AddSubgroup.zmultiples h)) := by
  classical
  by_cases hproper : AddSubgroup.closure ({a, h} : Set G) ≠ ⊤
  · exact Or.inl hproper
  · have hfull : AddSubgroup.closure ({a, h} : Set G) = ⊤ :=
      not_ne_iff.mp hproper
    rcases Nat.even_or_odd (Nat.card (G ⧸ AddSubgroup.zmultiples h)) with heven | hodd
    · exact Or.inr heven
    · obtain ⟨n, hdiff⟩ :=
        abelianThree_odd_trace_witness_of_odd_quotient a d h
          hhalf hne horder hfull hodd
      exact (hdiff (hbridge (2 * n + 1) hcospec)).elim

/-- An exact iff once the all-power trace bridge is available.
No unconditional spectral classification is claimed by this theorem:
the missing characteristic-polynomial-to-traces assertion is *visible*
as hbridge. -/
theorem abelianThree_spectral_equivalence_of_trace_bridge (a d h : G)
    (hhalf : h + h = 0) (hne : h ≠ 0)
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (hbridge :
      ∀ n : ℕ,
        (abelianCayleyMatrix (AbelianSource a d h)).charpoly =
          (abelianCayleyMatrix (AbelianTarget a d h)).charpoly →
        Matrix.trace (abelianCayleyMatrix (AbelianSource a d h) ^ n) =
          Matrix.trace (abelianCayleyMatrix (AbelianTarget a d h) ^ n)) :
    ((abelianCayleyMatrix (AbelianSource a d h)).charpoly =
        (abelianCayleyMatrix (AbelianTarget a d h)).charpoly) ↔
      (AddSubgroup.closure ({a, h} : Set G) ≠ ⊤ ∨
       Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) := by
  constructor
  · exact abelianThree_spectral_necessity_of_trace_bridge a d h
      hhalf hne horder hgen hbridge
  · exact abelianThreeCospectral_of_nongeneration_or_even_quotient a d h
      hhalf hne horder hgen

end Couret.CayleyDoublet

