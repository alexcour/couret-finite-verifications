import CayleyTwoColourSpectral

/-!
COU-20 — parity from finite quotient cardinality (17 October 2026).

The additive parity used by the directed spectral bridge is constructed here.
Let H be generated by h and assume G/H is finite, generated by the images of
a and d, with d+H of odd order. Then a character to ZMod 2 taking a to one
and h to zero exists exactly when G/H has even cardinality. The construction
also kills d. No half-turn or nonzero condition on h is needed for this part.

For the actual finite Cayley adjacency matrices the original nonzero half-turn,
exact order-three quotient and global generation premises are retained.
The disjunction of nongeneration by a,h and even quotient cardinality implies
cospectrality. This is the sufficient direction; the converse spectral
classification, independent human review and priority audit remain separate.
The earlier certified modules and their statements are imported unchanged.
-/

set_option autoImplicit false
noncomputable section

namespace Couret.CayleyParity

variable {Q : Type*} [AddGroup Q]

/-- Sending an additive generator to one modulo two is well defined whenever
its additive order is even. This also includes infinite order, represented by zero. -/
theorem exists_parity_of_even_generator_order (b : Q)
    (hgen : AddSubgroup.zmultiples b = ⊤)
    (heven : Even (addOrderOf b)) :
    ∃ χ : Q →+ ZMod 2, χ b = 1 := by
  classical
  let f : ℤ →+ Q := zmultiplesHom Q b
  let g : ℤ →+ ZMod 2 := Int.castAddHom (ZMod 2)
  have hsurj : Function.Surjective f := by
    intro x
    have hx : x ∈ AddSubgroup.zmultiples b := hgen.ge (AddSubgroup.mem_top x)
    exact hx
  have hker : f.ker ≤ g.ker := by
    intro k hk
    have hk' : k • b = 0 := hk
    have hdiv : (addOrderOf b : ℤ) ∣ k :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mpr hk'
    change (k : ZMod 2) = 0
    obtain ⟨r, rfl⟩ := hdiv
    have hz : ((addOrderOf b : ℕ) : ZMod 2) = 0 := heven.natCast_zmod_two
    simp [hz]
  let χ : Q →+ ZMod 2 := f.liftOfSurjective hsurj ⟨g, hker⟩
  refine ⟨χ, ?_⟩
  have hb : f 1 = b := by simp [f]
  rw [← hb]
  simp [χ, AddMonoidHom.liftOfSurjective, g]

/-- A finite cyclic additive group of even cardinality has a parity sending
the specified generator to one. -/
theorem exists_parity_of_even_card [Finite Q] (b : Q)
    (hgen : AddSubgroup.zmultiples b = ⊤)
    (heven : Even (Nat.card Q)) :
    ∃ χ : Q →+ ZMod 2, χ b = 1 := by
  classical
  letI : Fintype Q := Fintype.ofFinite Q
  have horder : addOrderOf b = Nat.card Q := by
    calc
      addOrderOf b = Fintype.card (AddSubgroup.zmultiples b) :=
        Fintype.card_zmultiples.symm
      _ = Nat.card (AddSubgroup.zmultiples b) := Nat.card_eq_fintype_card.symm
      _ = Nat.card Q := by rw [hgen, AddSubgroup.card_top]
  exact exists_parity_of_even_generator_order b hgen (horder ▸ heven)

/-- The same construction with the closure-of-singleton generation interface. -/
theorem exists_parity_of_even_card_of_closure [Finite Q] (b : Q)
    (hgen : AddSubgroup.closure ({b} : Set Q) = ⊤)
    (heven : Even (Nat.card Q)) :
    ∃ χ : Q →+ ZMod 2, χ b = 1 := by
  apply exists_parity_of_even_card b _ heven
  rwa [AddSubgroup.zmultiples_eq_closure]

end Couret.CayleyParity

namespace Couret.CayleyParity

/-- A homomorphism to the additive group of `ZMod 2` that takes the value `1`
is surjective. Neither finiteness nor commutativity of the source is required. -/
theorem surjective_of_value_one {Q : Type*} [AddGroup Q]
    (χ : Q →+ ZMod 2) (b : Q) (hb : χ b = 1) :
    Function.Surjective χ := by
  intro z
  fin_cases z
  · exact ⟨0, χ.map_zero⟩
  · exact ⟨b, hb⟩

/-- For finite groups this states that the existence of a nonzero parity
homomorphism forces even cardinality. The formulation using `Nat.card` is also
valid for infinite groups, whose `Nat.card` is zero. -/
theorem even_natCard_of_value_one {Q : Type*} [AddGroup Q]
    (χ : Q →+ ZMod 2) (b : Q) (hb : χ b = 1) :
    Even (Nat.card Q) := by
  apply even_iff_two_dvd.mpr
  simpa using
    AddSubgroup.card_dvd_of_surjective χ (surjective_of_value_one χ b hb)

theorem even_natCard_of_exists_parity {Q : Type*} [AddGroup Q] (b : Q)
    (hχ : ∃ χ : Q →+ ZMod 2, χ b = 1) :
    Even (Nat.card Q) := by
  obtain ⟨χ, hb⟩ := hχ
  exact even_natCard_of_value_one χ b hb

/-- Direct converse on the quotient by `h`. No order condition on `h` or any
other generator is used in this direction. -/
theorem even_natCard_quotient_of_parity {G : Type*} [AddCommGroup G]
    (a h : G) (ε : G →+ ZMod 2) (ha : ε a = 1) (hh : ε h = 0) :
    Even (Nat.card (G ⧸ AddSubgroup.zmultiples h)) := by
  have hker : AddSubgroup.zmultiples h ≤ ε.ker :=
    AddSubgroup.zmultiples_le.mpr (show h ∈ ε.ker from hh)
  let χ : (G ⧸ AddSubgroup.zmultiples h) →+ ZMod 2 :=
    QuotientAddGroup.lift (AddSubgroup.zmultiples h) ε hker
  apply even_natCard_of_value_one χ (a : G ⧸ AddSubgroup.zmultiples h)
  exact ha

/-- An odd annihilator forces every additive map to `ZMod 2` to vanish.
No finiteness, generation, or exact-order condition is needed. -/
theorem apply_eq_zero_of_odd_annihilator {Q : Type*} [AddMonoid Q]
    (χ : Q →+ ZMod 2) (δ : Q) (n : ℕ) (hn : Odd n) (hδ : n • δ = 0) :
    χ δ = 0 := by
  have h := congrArg χ hδ
  simpa only [map_nsmul, map_zero, nsmul_eq_mul, hn.natCast_zmod_two, one_mul] using h

/-- If an odd multiple of `d` is generated by `h`, vanishing at `h` forces
vanishing at `d`. In particular the exact order-three quotient hypothesis
is stronger than what is needed for the automatic equation `ε d = 0`. -/
theorem apply_eq_zero_of_odd_nsmul_mem_zmultiples {G : Type*} [AddCommGroup G]
    (d h : G) (ε : G →+ ZMod 2) (hh : ε h = 0)
    (n : ℕ) (hn : Odd n) (hd : n • d ∈ AddSubgroup.zmultiples h) :
    ε d = 0 := by
  have hker : AddSubgroup.zmultiples h ≤ ε.ker :=
    AddSubgroup.zmultiples_le.mpr (show h ∈ ε.ker from hh)
  have hz : ε (n • d) = 0 := hker hd
  simpa only [map_nsmul, nsmul_eq_mul, hn.natCast_zmod_two, one_mul] using hz


end Couret.CayleyParity

namespace Couret.CayleyDoublet

/-- Quotienting out one member of a generating pair leaves a cyclic quotient.
Neither finiteness nor an order condition on the killed generator is needed. -/
theorem abelian_quotient_zmultiples_generator_of_pair
    {Q : Type*} [AddCommGroup Q] (α δ : Q)
    (hgen : AddSubgroup.closure ({α, δ} : Set Q) = ⊤) :
    AddSubgroup.zmultiples (α : Q ⧸ AddSubgroup.zmultiples δ) = ⊤ := by
  apply top_unique
  intro q _
  refine QuotientAddGroup.induction_on q ?_
  intro z
  have hz : z ∈ AddSubgroup.closure ({α, δ} : Set Q) := by rw [hgen]; trivial
  obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.mp hz
  apply AddSubgroup.mem_zmultiples_iff.mpr
  refine ⟨m, ?_⟩
  have hδ : (δ : Q ⧸ AddSubgroup.zmultiples δ) = 0 :=
    (QuotientAddGroup.eq_zero_iff δ).mpr (AddSubgroup.mem_zmultiples δ)
  have he := congrArg (QuotientAddGroup.mk' (AddSubgroup.zmultiples δ)) hmn
  simpa only [map_add, map_zsmul, QuotientAddGroup.mk'_apply, hδ,
    zsmul_zero, add_zero] using he

theorem abelian_quotient_closure_singleton_of_pair
    {Q : Type*} [AddCommGroup Q] (α δ : Q)
    (hgen : AddSubgroup.closure ({α, δ} : Set Q) = ⊤) :
    AddSubgroup.closure ({(α : Q ⧸ AddSubgroup.zmultiples δ)} :
      Set (Q ⧸ AddSubgroup.zmultiples δ)) = ⊤ := by
  rw [← AddSubgroup.zmultiples_eq_closure]
  exact abelian_quotient_zmultiples_generator_of_pair α δ hgen

/-- An even finite group remains even after quotienting by an odd-order cyclic subgroup. -/
theorem abelian_quotient_natCard_even_of_odd_order
    {Q : Type*} [AddCommGroup Q] [Finite Q] (δ : Q)
    (hδ : Odd (addOrderOf δ)) (hcard : Even (Nat.card Q)) :
    Even (Nat.card (Q ⧸ AddSubgroup.zmultiples δ)) := by
  classical
  letI : Fintype Q := Fintype.ofFinite Q
  have hK : Nat.card (AddSubgroup.zmultiples δ) = addOrderOf δ := by
    rw [Nat.card_eq_fintype_card, Fintype.card_zmultiples]
  have hmul := (AddSubgroup.zmultiples δ).card_eq_card_quotient_mul_card_addSubgroup
  rw [hK] at hmul
  have hdiv : 2 ∣ Nat.card (Q ⧸ AddSubgroup.zmultiples δ) * addOrderOf δ := by
    rw [← hmul]
    exact even_iff_two_dvd.mp hcard
  rcases Nat.prime_two.dvd_mul.mp hdiv with hquot | horder
  · exact even_iff_two_dvd.mpr hquot
  · exact (hδ.not_two_dvd_nat horder).elim

theorem abelian_quotient_natCard_even_of_order_three
    {Q : Type*} [AddCommGroup Q] [Finite Q] (δ : Q)
    (hδ : addOrderOf δ = 3) (hcard : Even (Nat.card Q)) :
    Even (Nat.card (Q ⧸ AddSubgroup.zmultiples δ)) := by
  apply abelian_quotient_natCard_even_of_odd_order δ _ hcard
  rw [hδ]
  exact ⟨1, rfl⟩


end Couret.CayleyDoublet

namespace Couret.CayleyDoublet

variable {G : Type*} [AddCommGroup G]

/-- Generation by a,d,h descends to generation by a,d modulo the subgroup
generated by h. Neither finiteness nor torsion is needed. -/
theorem abelianQuotient_generated_pair (a d h : G)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤) :
    AddSubgroup.closure
      ({(a : G ⧸ AddSubgroup.zmultiples h),
        (d : G ⧸ AddSubgroup.zmultiples h)} : Set (G ⧸ AddSubgroup.zmultiples h)) = ⊤ := by
  let H := AddSubgroup.zmultiples h
  let q := QuotientAddGroup.mk' H
  have hh : (h : G ⧸ H) = 0 :=
    (QuotientAddGroup.eq_zero_iff h).mpr (AddSubgroup.mem_zmultiples h)
  have hm := congrArg (fun K : AddSubgroup G => K.map q) hgen
  change (AddSubgroup.closure ({a, d, h} : Set G)).map q =
    (⊤ : AddSubgroup G).map q at hm
  rw [AddMonoidHom.map_closure,
    AddSubgroup.map_top_of_surjective q (QuotientAddGroup.mk'_surjective H)] at hm
  simp only [Set.image_insert_eq, Set.image_singleton] at hm
  change AddSubgroup.closure ({(a : G ⧸ H), (d : G ⧸ H), (h : G ⧸ H)} :
    Set (G ⧸ H)) = ⊤ at hm
  rw [hh] at hm
  have hs : ({(a : G ⧸ H), (d : G ⧸ H), 0} : Set (G ⧸ H)) =
      insert 0 {(a : G ⧸ H), (d : G ⧸ H)} := by
    ext x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  rw [hs, AddSubgroup.closure_insert_zero] at hm
  exact hm


end Couret.CayleyDoublet

namespace Couret.CayleyDoublet

/-- Killing an odd-order member of a generating pair leaves an even cyclic
quotient. Reducing its distinguished generator modulo two gives the character. -/
theorem abelianPairParity_of_even_card_of_odd_order
    {Q : Type*} [AddCommGroup Q] [Finite Q] (α δ : Q)
    (hgen : AddSubgroup.closure ({α, δ} : Set Q) = ⊤)
    (horder : Odd (addOrderOf δ)) (heven : Even (Nat.card Q)) :
    ∃ χ : Q →+ ZMod 2, χ α = 1 ∧ χ δ = 0 := by
  obtain ⟨ψ, hψ⟩ := Couret.CayleyParity.exists_parity_of_even_card
    (α : Q ⧸ AddSubgroup.zmultiples δ)
    (abelian_quotient_zmultiples_generator_of_pair α δ hgen)
    (abelian_quotient_natCard_even_of_odd_order δ horder heven)
  refine ⟨ψ.comp (QuotientAddGroup.mk' (AddSubgroup.zmultiples δ)), hψ, ?_⟩
  change ψ (δ : Q ⧸ AddSubgroup.zmultiples δ) = 0
  rw [(QuotientAddGroup.eq_zero_iff δ).mpr (AddSubgroup.mem_zmultiples δ), map_zero]

variable {G : Type*} [AddCommGroup G]

/-- The parity construction only requires finiteness of the quotient by h,
generation, and odd order of d in that quotient. No condition on the order or
nonzeroness of h is used. -/
theorem abelianParity_of_even_quotient_of_odd_order (a d h : G)
    [Finite (G ⧸ AddSubgroup.zmultiples h)]
    (horder : Odd (addOrderOf (d : G ⧸ AddSubgroup.zmultiples h)))
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (heven : Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    ∃ ε : G →+ ZMod 2, ε a = 1 ∧ ε d = 0 ∧ ε h = 0 := by
  obtain ⟨χ, hχa, hχd⟩ := abelianPairParity_of_even_card_of_odd_order
    (a : G ⧸ AddSubgroup.zmultiples h) (d : G ⧸ AddSubgroup.zmultiples h)
    (abelianQuotient_generated_pair a d h hgen) horder heven
  refine ⟨χ.comp (QuotientAddGroup.mk' (AddSubgroup.zmultiples h)), hχa, hχd, ?_⟩
  change χ (h : G ⧸ AddSubgroup.zmultiples h) = 0
  rw [(QuotientAddGroup.eq_zero_iff h).mpr (AddSubgroup.mem_zmultiples h), map_zero]

/-- Under the stated generation and odd-order premises, parity exists exactly
when the finite quotient has even cardinality. The reverse implication uses
neither generation nor any order condition. -/
theorem abelianParity_exists_iff_even_quotient_of_odd_order (a d h : G)
    [Finite (G ⧸ AddSubgroup.zmultiples h)]
    (horder : Odd (addOrderOf (d : G ⧸ AddSubgroup.zmultiples h)))
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤) :
    (∃ ε : G →+ ZMod 2, ε a = 1 ∧ ε h = 0) ↔
      Even (Nat.card (G ⧸ AddSubgroup.zmultiples h)) := by
  constructor
  · rintro ⟨ε, ha, hh⟩
    exact Couret.CayleyParity.even_natCard_quotient_of_parity a h ε ha hh
  · intro heven
    obtain ⟨ε, ha, _, hh⟩ :=
      abelianParity_of_even_quotient_of_odd_order a d h horder hgen heven
    exact ⟨ε, ha, hh⟩

/-- The exact order-three interface used by the directed Cayley family. -/
theorem abelianThreeParity_of_even_quotient (a d h : G)
    [Finite (G ⧸ AddSubgroup.zmultiples h)]
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (heven : Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    ∃ ε : G →+ ZMod 2, ε a = 1 ∧ ε d = 0 ∧ ε h = 0 := by
  apply abelianParity_of_even_quotient_of_odd_order a d h _ hgen heven
  rw [horder]
  exact ⟨1, rfl⟩

theorem abelianThreeParity_exists_iff_even_quotient (a d h : G)
    [Finite (G ⧸ AddSubgroup.zmultiples h)]
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤) :
    (∃ ε : G →+ ZMod 2, ε a = 1 ∧ ε h = 0) ↔
      Even (Nat.card (G ⧸ AddSubgroup.zmultiples h)) := by
  apply abelianParity_exists_iff_even_quotient_of_odd_order a d h _ hgen
  rw [horder]
  exact ⟨1, rfl⟩

end Couret.CayleyDoublet

