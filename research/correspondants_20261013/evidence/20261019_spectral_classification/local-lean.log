Matrix.trace_eq_sum_roots_charpoly_of_splits.{u_1, u_3} {n : Type u_1} [Fintype n] [DecidableEq n] {K : Type u_3}
  [Field K] {A : Matrix n n K} (hAps : A.charpoly.Splits) : A.trace = A.charpoly.roots.sum
Matrix.trace_eq_neg_charpoly_coeff.{u, v} {R : Type u} [CommRing R] {n : Type v} [DecidableEq n] [Fintype n]
  [Nonempty n] (M : Matrix n n R) : M.trace = -M.charpoly.coeff (Fintype.card n - 1)
Matrix.charpolyRev.{u, v} {R : Type u} [CommRing R] {n : Type v} [DecidableEq n] [Fintype n] (M : Matrix n n R) :
  Polynomial R
Matrix.coeff_det_one_add_X_smul_one.{u, v} {R : Type u} [CommRing R] {n : Type v} [DecidableEq n] [Fintype n]
  (M : Matrix n n R) : (1 + Polynomial.X • M.map ⇑Polynomial.C).det.coeff 1 = M.trace
Matrix.derivative_det_one_add_X_smul.{u, v} {R : Type u} [CommRing R] {n : Type v} [DecidableEq n] [Fintype n]
  (M : Matrix n n R) : Polynomial.eval 0 (Polynomial.derivative (1 + Polynomial.X • M.map ⇑Polynomial.C).det) = M.trace
MvPolynomial.psum_eq_mul_esymm_sub_sum.{u_1, u_2} (σ : Type u_1) [Fintype σ] (R : Type u_2) [CommRing R] (k : ℕ)
  (h : 0 < k) :
  MvPolynomial.psum σ R k =
    (-1) ^ (k + 1) * ↑k * MvPolynomial.esymm σ R k -
      ∑ a ∈ Finset.antidiagonal k with a.1 ∈ Set.Ioo 0 k,
        (-1) ^ a.1 * MvPolynomial.esymm σ R a.1 * MvPolynomial.psum σ R a.2
MvPolynomial.mul_esymm_eq_sum.{u_1, u_2} (σ : Type u_1) [Fintype σ] (R : Type u_2) [CommRing R] (k : ℕ) :
  ↑k * MvPolynomial.esymm σ R k =
    (-1) ^ (k + 1) *
      ∑ a ∈ Finset.antidiagonal k with a.1 < k, (-1) ^ a.1 * MvPolynomial.esymm σ R a.1 * MvPolynomial.psum σ R a.2
